# -----------------------------------------------------------------------------
# 核心与安全配置
# -----------------------------------------------------------------------------

# API 访问密钥（用户端只读接口，客户端请求需在 x-api-key 请求头中传递此值）
PEANUT_API_SECRET=your-strong-secret-key-here

# 管理员密钥（管理端写操作接口专用，如上传、删除、配置等）
# 若不填，则自动与 PEANUT_API_SECRET 相同（向后兼容，不推荐生产环境使用此默认值）
PEANUT_ADMIN_SECRET=your-strong-admin-secret-here

# 生产环境标记 (true: 生产环境, false: 开发环境)
PEANUT_PRODUCTION=false

# 数据库文件路径（建议放在后端 Web 根目录外）
PEANUT_DB_FILE=/path/to/project/data/timeline.db

# -----------------------------------------------------------------------------
# 资源与网络配置
# -----------------------------------------------------------------------------

# 上传图片及视频的保存目录路径
# PEANUT_UPLOAD_DIR=/path/to/custom/uploads

# 站点的基础 URL，用于生成上传文件的完整链接（包含协议和域名）
# 生产环境强烈推荐配置！例如：https://api.example.com
PEANUT_BASE_URL=

# CORS 跨域白名单（多个域名用逗号分隔，不支持通配符 *）
# 如果不填，默认只允许 localhost 和 127.0.0.1 (见 config.php 中的默认配置)
PEANUT_CORS_ALLOWED_ORIGINS=https://hetao.us,https://admin.hetao.us,https://duanxinyu.hetao.us

# 是否在外部 HTTPS 请求中开启 SSL 证书校验 (true/false)
PEANUT_SSL_VERIFY=true

# -----------------------------------------------------------------------------
# 媒体与第三方服务
# -----------------------------------------------------------------------------

# 生成缩略图的最大宽度（像素）
PEANUT_THUMB_MAX_WIDTH=800

# 生成缩略图的质量（1-100，100为最好质量且体积最大）
PEANUT_THUMB_QUALITY=60

# ffmpeg 可执行文件路径（默认直接使用 ffmpeg）
# PEANUT_FFMPEG_BIN=ffmpeg

# PHP CLI 可执行文件路径（用于后台处理分片视频；留空时自动探测）
PEANUT_PHP_CLI_BIN=/usr/bin/php

# 分片上传临时目录（建议放系统盘，不要放到网盘挂载目录）
PEANUT_CHUNK_TMP_DIR=/tmp/peanut-timeline-chunks

# 上传成功但尚未提交入库的跟踪目录
PEANUT_PENDING_UPLOAD_DIR=/tmp/peanut-timeline-pending

# 视频处理本地临时目录（建议放系统盘，不要放到网盘挂载目录）
PEANUT_VIDEO_TMP_DIR=/tmp/peanut-timeline-video

# 视频转码 preset（常用：ultrafast / superfast / veryfast / medium）
PEANUT_VIDEO_TRANSCODE_PRESET=superfast

# 视频转码 CRF（越小越清晰，体积越大；常用 21-25）
PEANUT_VIDEO_TRANSCODE_CRF=24

# 视频转码线程数（2 核机器可先用 2）
PEANUT_VIDEO_TRANSCODE_THREADS=2

# 高德地图 Web 服务 API Key
# 用于解析照片的经纬度并返回中文地址
PEANUT_AMAP_KEY=your-amap-key-here
